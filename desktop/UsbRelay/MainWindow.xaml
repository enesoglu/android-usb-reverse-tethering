<Window x:Class="UsbRelayDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="USB Relay" Width="1140" Height="860" MinWidth="970" MinHeight="620" Background="#0D1623" WindowStartupLocation="CenterScreen"><Grid Background="#0D1623"><Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#101C2B" BorderBrush="#223146" BorderThickness="0,0,1,0"><Grid Margin="22,30,18,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Border Background="#47D7B5" CornerRadius="11" Width="44" Height="44"><TextBlock Text="↗" Foreground="#082D27" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="USB" FontSize="24" FontWeight="Bold"/><TextBlock Text="R E L A Y" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel><TextBlock Text="A closer connection." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,18,0,34"/><Button Style="{StaticResource Navigation}" Content="Connection" Tag="Connection" Click="Navigate"/><Button Style="{StaticResource Navigation}" Content="Your devices" Tag="Devices" Click="Navigate"/><Button Style="{StaticResource Navigation}" Content="Preferences" Tag="Settings" Click="Navigate"/><Button Style="{StaticResource Navigation}" Content="Security" Tag="Security" Click="Navigate"/></StackPanel><StackPanel Grid.Row="2"><Border Background="#173A36" CornerRadius="7" Padding="10,7" HorizontalAlignment="Left"><TextBlock Text="●  LOCAL · NO CLOUD" Foreground="#68DABE" FontSize="10" FontWeight="SemiBold"/></Border><TextBlock Text="USB Relay 0.3.0-alpha.1" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,15,0,0"/><Button Content="Setup help" Style="{StaticResource Navigation}" Padding="0,14" HorizontalAlignment="Left" Click="Help"/></StackPanel></Grid></Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="36,28,36,30">
<StackPanel x:Name="ConnectionPage"><TextBlock Text="Your phone. Your internet." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="A private connection between your PC and Android, over USB." Foreground="{StaticResource Muted}" Margin="0,8,0,26"/>
<Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Border x:Name="StatusBadge" Background="#25374B" CornerRadius="6" HorizontalAlignment="Left" Padding="10,5"><TextBlock x:Name="StatusText" Text="GETTING READY" FontSize="10" FontWeight="Bold" Foreground="#A5B8D1"/></Border><TextBlock x:Name="HeroTitle" Text="Ready when you are" FontSize="25" FontWeight="SemiBold" Margin="0,17,0,9"/><TextBlock x:Name="HeroMessage" Text="Looking for your USB phone…" TextWrapping="Wrap" Foreground="{StaticResource Muted}" MaxWidth="460" HorizontalAlignment="Left" MinHeight="28"/><ComboBox x:Name="DeviceSelector" AutomationProperties.Name="USB phone" HorizontalAlignment="Left" MinWidth="290" Margin="0,14,0,0" SelectionChanged="DeviceChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="ConnectButton" Content="Connect securely" Style="{StaticResource Primary}" Click="Connect" IsEnabled="False"/><Button x:Name="DisconnectButton" Content="Disconnect" Margin="10,0,0,0" Click="Disconnect" IsEnabled="False"/></StackPanel></StackPanel><Border Grid.Column="1" Background="#1C3342" Width="88" Height="106" CornerRadius="17" Margin="20,18,0,0" VerticalAlignment="Top"><StackPanel VerticalAlignment="Center"><TextBlock Text="▯" FontSize="42" Foreground="#47D7B5" HorizontalAlignment="Center"/><TextBlock Text="USB" FontSize="11" Foreground="#A8C4CC" HorizontalAlignment="Center"/></StackPanel></Border></Grid></Border>
<Grid Margin="0,18,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="DOWNLOAD" Foreground="{StaticResource Muted}" FontSize="10"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock x:Name="DownloadText" Text="0.0" FontSize="29" FontWeight="SemiBold"/><TextBlock Text=" Mbps" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,5"/></StackPanel><TextBlock x:Name="DownloadTotal" Text="0 B received" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0" Padding="20"><StackPanel><TextBlock Text="UPLOAD" Foreground="{StaticResource Muted}" FontSize="10"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock x:Name="UploadText" Text="0.0" FontSize="29" FontWeight="SemiBold"/><TextBlock Text=" Mbps" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,5"/></StackPanel><TextBlock x:Name="UploadTotal" Text="0 B sent" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="CONNECTED FOR" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="UptimeText" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock x:Name="EncryptionText" Text="TLS 1.3 when connected" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border></Grid>
<Border Style="{StaticResource Card}" Padding="22"><StackPanel><DockPanel><TextBlock Text="Live traffic" FontWeight="SemiBold"/><TextBlock Text="Last 30 seconds" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></DockPanel><Canvas x:Name="TrafficCanvas" Height="78" Margin="0,15,0,10" SizeChanged="ChartSizeChanged" ClipToBounds="True"><Polyline x:Name="DownloadLine" Stroke="#47D7B5" StrokeThickness="2"/><Polyline x:Name="UploadLine" Stroke="#9C9BFF" StrokeThickness="2"/></Canvas><DockPanel><TextBlock Text="● Download      ● Upload" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="PressureText" Text="Queue rejections: 0" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border><TextBlock Text="Only phones you trust can reconnect automatically. First use requires Android's VPN approval." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,18,0,0"/></StackPanel>
<StackPanel x:Name="DevicesPage" Visibility="Collapsed"><TextBlock Text="Your devices" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Pair once. Reconnect only when the saved phone identity matches." Foreground="{StaticResource Muted}" Margin="0,9,0,25" TextWrapping="Wrap"/><ItemsControl x:Name="TrustedList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Model}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ShortPin}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/><TextBlock Text="{Binding PairedLabel}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="Forget" Tag="{Binding Serial}" Click="Forget" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoTrustedText" Text="No paired phones yet. Connect a phone and choose Trust &amp; connect." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
<StackPanel x:Name="SettingsPage" Visibility="Collapsed"><TextBlock Text="Make it yours" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Changes take effect after saving. Network changes apply to the next connection." Foreground="{StaticResource Muted}" Margin="0,9,0,24" TextWrapping="Wrap"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Everyday convenience" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox x:Name="StartupCheck" Content="Start with Windows" Click="EditSettings"/><TextBlock Text="Launch automatically after you sign in. No administrator rights needed." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,10"/><CheckBox x:Name="StartMinimizedCheck" Content="Start minimized to the system tray" Click="EditSettings" Margin="22,0,0,10"/><TextBlock Text="Open without showing the window. Double-click the tray icon to bring it back." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,10"/><CheckBox x:Name="AutoConnectCheck" Content="Automatically connect trusted phones" Click="EditSettings"/><CheckBox x:Name="MinimizeCheck" Content="Minimize to the system tray" Click="EditSettings"/><CheckBox x:Name="CloseTrayCheck" Content="Keep running in the tray when I close the window" Click="EditSettings"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,20"><StackPanel><TextBlock Text="Network access" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox x:Name="LANCheck" Content="Allow access to other devices on my local network" Click="EditSettings"/><TextBlock Text="PC localhost services stay blocked. IPv4 TCP and UDP are supported." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,16"/><TextBlock Text="DNS server (IPv4)" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="DnsText" Width="260" HorizontalAlignment="Left" TextChanged="DnsEdited"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Android platform tools" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Detected automatically from the Android SDK. Set a path only if discovery fails; restart the app after changing it." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,12"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Margin="10,0,0,0" Click="BrowseAdb"/><TextBox x:Name="AdbPathText" TextChanged="DnsEdited" /></DockPanel></StackPanel></Border><StackPanel Orientation="Horizontal"><Button Content="Save preferences" Style="{StaticResource Primary}" Click="SaveSettings"/><TextBlock x:Name="SavedText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel></StackPanel>
<StackPanel x:Name="SecurityPage" Visibility="Collapsed"><TextBlock Text="Private by design" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Clear protections. No hidden driver or network changes." Foreground="{StaticResource Muted}" Margin="0,9,0,24"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TLS 1.3 · Mutual authentication" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Both endpoints verify a pinned identity. Unknown phones require pairing; changed keys never become trusted silently." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,20"/><TextBlock Text="This computer's public fingerprint" FontSize="12" Foreground="{StaticResource Muted}"/><TextBox x:Name="HostPinText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,9,0,12"/><Button Content="Copy public fingerprint" HorizontalAlignment="Left" Click="CopyPin"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Keys stay protected" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Windows identity and pairings: per-user DPAPI.&#10;Phone signing key: non-exportable Android Keystore.&#10;Control channel: parent-owned local process pipes.&#10;No traffic contents, destinations or secrets in diagnostics." TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="25" Margin="0,12,0,0"/></StackPanel></Border><TextBlock Text="For strict no-fallback protection, enable Always-on VPN and Block connections without VPN in Android. This development build is not independently security-audited or Windows code-signed." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,20,0,18"/><TextBlock Text="Copyright 2026 USB Relay contributors. Free software under GNU GPL version 3 only. No warranty." TextWrapping="Wrap" Margin="0,16,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Button Content="View license" Click="OpenLicense"/><Button Content="Source code" Click="OpenSource" Margin="10,0,0,0"/></StackPanel><Button Content="Copy safe diagnostics" HorizontalAlignment="Left" Click="CopyDiagnostics"/></StackPanel>
</Grid></ScrollViewer></Grid></Window>